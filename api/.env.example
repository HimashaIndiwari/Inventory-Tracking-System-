# Backend configuration — copy the values into your IntelliJ run configuration or PowerShell session.
# Never commit real values.

DB_URL=jdbc:mysql://localhost:3306/inventory_db?connectionTimeZone=UTC
DB_USERNAME=inventory_dev
DB_PASSWORD=<mysql-password>

# Absolute path to the Firebase service-account JSON of the NON-production project, stored outside the repository
GOOGLE_APPLICATION_CREDENTIALS=<absolute-path-to-service-account.json>

# Comma-separated admin emails (must also be verified in Firebase)
APP_SECURITY_ADMIN_EMAILS=indiwari2022@gmail.com
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
